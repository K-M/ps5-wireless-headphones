CONFIG_IDF_TARGET="esp32s3"
CONFIG_FREERTOS_HZ=1000
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_ESPTOOLPY_FLASHMODE_DIO=y
CONFIG_ESPTOOLPY_FLASHSIZE_2MB=y
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y
# Radio: continuous stream reception
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=16
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=64
CONFIG_ESP_WIFI_AMPDU_TX_ENABLED=n
CONFIG_ESP_WIFI_AMPDU_RX_ENABLED=n
# USB host audio: shallow queue for low latency (3 x 1 ms isochronous packets in flight)
CONFIG_UAC_NUM_ISOC_URBS=3
CONFIG_UAC_NUM_PACKETS_PER_URB=1
# Measured helpful in radio test (receiver B)
CONFIG_ESP_WIFI_STA_DISCONNECTED_PM_ENABLE=n
CONFIG_ESP_WIFI_RX_MGMT_BUF_NUM_DEF=10
CONFIG_ESP_MAIN_TASK_STACK_SIZE=6144
# ESP32-S3 USB host: default FIFO split caps isochronous OUT at 128 B; dongle needs 192 B
CONFIG_USB_HOST_HW_BUFFER_BIAS_PERIODIC_OUT=y
